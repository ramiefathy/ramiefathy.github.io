---
import '../styles/global.css';
import profile from '../data/profile.json';
const {
  title = 'Ramie Fathy, MD',
  description = 'Dermatology resident physician, researcher, and writer with a focus on human-centered AI and complex medical dermatology.',
  canonical
} = Astro.props;

const siteUrl = (Astro.site instanceof URL ? Astro.site.toString() : Astro.site) || 'https://ramiefathy.com';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL('/og.svg', siteUrl).toString();

const footerLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Apps & Projects', href: '/apps' },
  { label: 'Research', href: '/research' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' }
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#041020" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4fbff" media="(prefers-color-scheme: light)" />
    <meta property="og:site_name" content="Ramie Fathy, MD" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/style.css" />
    <script is:inline>
      (function () {
        try {
          const stored = window.localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (err) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2958059905874922" crossorigin="anonymous"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div id="scroll-fade-status" class="sr-only" role="status" aria-live="polite"></div>
    <slot />
    <footer class="layout-footer">
      <div class="layout-footer__inner">
        <div class="layout-footer__brand">
          <p class="layout-footer__name">{profile.name}</p>
          <p class="layout-footer__tagline">{profile.title}</p>
          <p class="layout-footer__meta">
            © {new Date().getFullYear()} {profile.name}. Built with Astro.
          </p>
        </div>
        <div class="layout-footer__nav" aria-label="Footer navigation">
          <div class="layout-footer__group">
            <p class="layout-footer__group-title">Explore</p>
            {footerLinks.slice(0, 4).map((link) => (
              <a href={link.href} class="layout-footer__link">{link.label}</a>
            ))}
          </div>
          <div class="layout-footer__group">
            <p class="layout-footer__group-title">More</p>
            {footerLinks.slice(4).map((link) => (
              <a href={link.href} class="layout-footer__link">{link.label}</a>
            ))}
          </div>
          <div class="layout-footer__group">
            <p class="layout-footer__group-title">Connect</p>
            <a class="layout-footer__link" href={profile.contact.email}>Email</a>
            <a class="layout-footer__link" href={profile.contact.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
            <a class="layout-footer__link" href={profile.contact.scholar} target="_blank" rel="noreferrer">Google Scholar</a>
            <a class="layout-footer__link" href={profile.contact.researchgate} target="_blank" rel="noreferrer">ResearchGate</a>
          </div>
        </div>
      </div>
    </footer>
    <script>
      const adSlots = document.querySelectorAll('.adsbygoogle');
      adSlots.forEach((slot) => {
        if (!slot.dataset.slotInitialized && slot.dataset.adSlot) {
          slot.dataset.slotInitialized = 'true';
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        }
      });
    </script>
    <script>
      (function(){
        const elements = new Set(Array.from(document.querySelectorAll('[data-scroll-fade]')));
        const status = document.getElementById('scroll-fade-status');
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        const applyDelayToken = (el) => {
          const delay = el.getAttribute('data-enter-delay');
          if (delay) el.style.setProperty('--enter-delay', delay);
        };

        const revealAll = () => {
          elements.forEach((el) => el.classList.add('is-visible'));
          if (status) status.textContent = '';
        };

        if (!elements.size) return;

        if (!('IntersectionObserver' in window) || prefersReducedMotion.matches) {
          revealAll();
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
              if (status) status.textContent = entry.target.getAttribute('data-scroll-label') || 'Section content is ready';
            }
          });
        }, { threshold: 0.15 });

        const observe = (el) => {
          if (elements.has(el)) return;
          elements.add(el);
          applyDelayToken(el);
          observer.observe(el);
        };

        elements.forEach((el) => {
          applyDelayToken(el);
          observer.observe(el);
        });

        const mutationObserver = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            mutation.addedNodes.forEach((node) => {
              if (!(node instanceof Element)) return;
              if (node.matches?.('[data-scroll-fade]')) observe(node);
              node.querySelectorAll?.('[data-scroll-fade]').forEach((child) => observe(child));
            });
          });
        });

        mutationObserver.observe(document.documentElement, { childList: true, subtree: true });

        prefersReducedMotion.addEventListener('change', () => {
          if (prefersReducedMotion.matches) {
            observer.disconnect();
            mutationObserver.disconnect();
            revealAll();
          }
        });
      })();
    </script>
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.warn('Service worker registration failed', err);
          });
        });
      }
    </script>
  </body>
</html>
