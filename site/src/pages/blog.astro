---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.jsx';
import posts from '../data/blog.json';
const sorted = posts.sort((a, b) => new Date(b.date) - new Date(a.date));

const TAG_GRADIENTS = {
  AI: ['#0ea5e9', '#22d3ee'],
  Dermatology: ['#14b8a6', '#0ea5e9'],
  Research: ['#38bdf8', '#d946ef'],
  'Medical Education': ['#a78bfa', '#f472b6'],
  Equity: ['#f97316', '#f43f5e'],
  Policy: ['#6366f1', '#22d3ee']
};

const FALLBACK_GRADIENTS = [
  ['#0ea5e9', '#22d3ee'],
  ['#10b981', '#0ea5e9'],
  ['#a78bfa', '#22d3ee'],
  ['#f43f5e', '#f59e0b'],
  ['#38bdf8', '#d946ef']
];

function hashString(value) {
  let hash = 0;
  for (let i = 0; i < value.length; i += 1) {
    hash = (hash * 31 + value.charCodeAt(i)) >>> 0;
  }
  return hash;
}

function pickGradient(tags, title) {
  if (Array.isArray(tags)) {
    for (const tag of tags) {
      if (TAG_GRADIENTS[tag]) return TAG_GRADIENTS[tag];
    }
  }
  const idx = hashString(String(title || 'post')) % FALLBACK_GRADIENTS.length;
  return FALLBACK_GRADIENTS[idx];
}
---
<MainLayout title="Blog – Ramie Fathy, MD" description="Insights on dermatology, medical education, and human-centered AI.">
  <Header client:load />
  <main id="main-content">
    <section class="section">
      <div class="section__inner scroll-fade" data-scroll-fade>
        <div class="section__intro">
          <h1 class="section__title">Insights & Updates</h1>
          <p class="section__subtitle">Periodic essays and media features covering clinical dermatology, translational AI, and the design of digital tools for resident workflows.</p>
        </div>
        <div class="post-grid">
          {sorted.map((post) => {
            const [accentA, accentB] = pickGradient(post.tags, post.title);
            const kicker = post.tags?.[0] ?? 'Insight';
            return (
            <article class="post-card" data-scroll-fade style={`--post-accent-a:${accentA};--post-accent-b:${accentB}`}>
              <div class="post-card__cover" aria-hidden="true">
                <div class="post-card__cover-kicker">{kicker}</div>
              </div>
              <div class="post-meta">
                <time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
                <div class="post-tags">
                  {post.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
              <h2 class="post-title">{post.title}</h2>
              <p class="post-summary">{post.summary}</p>
              <a class="button button--secondary" href={post.href} target="_blank" rel="noreferrer">Read More</a>
            </article>
            );
          })}
        </div>
      </div>
    </section>
  </main>
</MainLayout>
