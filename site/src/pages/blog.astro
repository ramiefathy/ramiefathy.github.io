---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.jsx';
import posts from '../data/blog.json';

const sorted = posts.sort((a, b) => new Date(b.date) - new Date(a.date));
const featured = sorted[0];
const archive = sorted.slice(1);

function shortYear(date) {
  const y = new Date(date).getFullYear();
  return `'${String(y).slice(-2)}`;
}

function shortDate(date) {
  const d = new Date(date);
  return `${String(d.getMonth() + 1).padStart(2, '0')} · ${d.getFullYear()}`;
}

function primaryKind(tags) {
  return (Array.isArray(tags) && tags[0]) || 'Essay';
}

function venue(tags) {
  return (Array.isArray(tags) && tags[1]) || '';
}

const featuredQuote = featured?.summary || '';
---
<MainLayout title="Blog – Ramie Fathy, MD" description="Insights on dermatology, medical education, and human-centered AI.">
  <Header client:load />
  <main id="main-content">
    <section class="section">
      <div class="plate-stamp"><b>Blog</b><span class="barcode"></span><span>Field notes & dispatches</span></div>

      <div class="plate-head">
        <div>
          <span class="kicker">Insights & updates</span>
          <h1 class="display1" style="margin-top:14px">Field <em>notes</em><br>and dispatches.</h1>
        </div>
        <div class="right">
          Periodic essays and<br>
          media features.<br>
          <span style="color:var(--terracotta)">Quarterly · since 2019</span>
        </div>
      </div>

      {featured && (
        <div class="blog-cover">
          <div class="blog-feature-img">
            <blockquote>{featuredQuote}</blockquote>
          </div>
          <div class="blog-feature-meta">
            <div class="stamp"><span><b>Featured</b> · {primaryKind(featured.tags)}</span><span>{new Date(featured.date).getFullYear()} · 8 min</span></div>
            <h3>{featured.title}</h3>
            <p class="lede" style="font-size:16px">{featured.summary}</p>
            <div style="display:flex;gap:24px;align-items:center">
              <a class="button button--primary" href={featured.href} target="_blank" rel="noreferrer">Read the essay →</a>
              <span style="font-family:var(--font-mono);font-size:11px;color:var(--slate)">{venue(featured.tags)}</span>
            </div>
          </div>
        </div>
      )}

      <div class="blog-archive">
        <div class="head">
          <h4>Archive · {archive.length} entries</h4>
          <div class="filters">
            <span class="active">All</span>
          </div>
        </div>
        <div class="blog-rows">
          {archive.map((post) => (
            <a class="br" href={post.href} target="_blank" rel="noreferrer" style="text-decoration:none;color:inherit">
              <div class="c year">{shortYear(post.date)}</div>
              <div class="c kind">{primaryKind(post.tags)}</div>
              <div class="c title">{post.title}</div>
              <div class="c venue">{venue(post.tags)} · {shortDate(post.date)}</div>
              <div class="c arrow">→</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</MainLayout>
