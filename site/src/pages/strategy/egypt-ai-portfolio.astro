---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.jsx';
import EgyptPortfolioDashboard from '../../components/EgyptPortfolioDashboard.jsx';

const title = 'Egypt AI & Technology Opportunity Portfolio – Ramie Fathy, MD';
const description = 'Unlisted unified strategy dashboard, source deck, and evidence model for an Egypt AI and technology opportunity portfolio.';
