---
import MainLayout from '../../../layouts/MainLayout.astro';
import Header from '../../../components/Header.jsx';
import MindMapApp from '../../../apps/mindmaps/MindMapApp.tsx';
import { getMindMapDataset, listAvailableMindMaps } from '../../../apps/mindmaps/dataLoader';
import type { MindMapDataset } from '../../../apps/mindmaps/types';

export function getStaticPaths() {
  const manifests = listAvailableMindMaps();
  return manifests
    .map((manifest) => {
      const dataset = getMindMapDataset(manifest.id);
      if (!dataset) return null;
      return {
        params: { topic: manifest.id },
        props: { dataset }
      };
    })
    .filter(Boolean);
}

const { dataset } = Astro.props as { dataset: MindMapDataset };

if (!dataset) {
  throw Astro.redirect('/apps');
}

const available = listAvailableMindMaps();
const otherMaps = available.filter((manifest) => manifest.id !== dataset.manifest.id);
---
<MainLayout title={`${dataset.manifest.title} – Interactive Mind Map`} description={`Interactive dermatology mind map for ${dataset.manifest.title}.`}>
  <Header client:load />
  <main id="main-content" class="mindmap-page">
    <section class="section mindmap-intro">
      <div class="section-marker"><b>$</b><span>open mindmap/{dataset.manifest.id}</span></div>
      <div class="section-head">
        <div>
          <span class="kicker">Interactive · D3 · Searchable</span>
          <h1 class="display1 mindmap-title">{dataset.manifest.title}</h1>
        </div>
        <div class="right">
          Diagnostic pathways +<br>
          treatment strategies.<br>
          <span style="color:var(--terracotta)">Tabs · Search · Export</span>
        </div>
      </div>
      <p class="lede">
        Explore diagnostic pathways, disease classifications, and treatment strategies using an accessible, fully interactive mind map.
        Tabs organize content into focused perspectives; search, annotations, and export tools support study and teaching workflows.
      </p>
      {otherMaps.length ? (
        <p class="mindmap-other">
          Other mind maps: {otherMaps.map((map, i) => (
            <span><a href={`/apps/mindmaps/${map.id}`} style="color:var(--terracotta);border-bottom:1px solid var(--terracotta)">{map.title}</a>{i < otherMaps.length - 1 ? ' · ' : ''}</span>
          ))}
        </p>
      ) : null}
    </section>
    <section class="mindmap-runtime" id="mindmap-runtime">
      <MindMapApp client:load dataset={dataset} />
    </section>
  </main>
  <style is:global>
    @import '../../../styles/mindmap.css';
  </style>
</MainLayout>
