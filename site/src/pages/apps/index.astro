---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.jsx';
import AppsGallery from '../../components/AppsGallery.jsx';
import apps from '../../data/apps.json';
import collections from '../../data/collections.json';

const active = apps.filter((app) => app.status === 'active');
const beta = apps.filter((app) => app.status === 'beta');
const archived = apps.filter((app) => app.status === 'legacy');
---
<MainLayout title="Applications – Ramie Fathy, MD" description="Interactive dermatology tools and prototypes developed by Dr. Ramie Fathy.">
  <Header client:load />
  <main id="main-content">
    <section class="section" style="padding-top:4rem">
      <div class="section__inner">
        <div class="section__intro" style="margin-bottom:2.5rem">
          <h1 class="section__title">Modern Dermatology Workflows</h1>
          <p class="section__subtitle">Each application below is built for resident clinics, dermatology education, or translational research—and runs directly in the browser with no account required.</p>
        </div>

        <AppsGallery
          apps={apps}
          collections={collections}
          client:load
        />
      </div>
    </section>

    {false && archived.length ? (
      <section class="section" style="background:linear-gradient(180deg, rgba(236,253,245,0.6), rgba(255,255,255,0.94))">
        <div class="section__inner">
          <div class="section__intro">
            <h2 class="section__title">Archived Experiments</h2>
            <p class="section__subtitle">Legacy prototypes and documentation retained for historical context and reproducibility.</p>
          </div>
          <div class="card-grid">
            {archived.map((app) => (
              <a class="card" href={app.href}>
                <h3 class="card__title">{app.name}</h3>
                <p>{app.description || 'Experimental project archived for reference.'}</p>
                <div class="card__meta">
                  <span class="tag">Legacy</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ) : null}
  </main>

</MainLayout>
