---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.jsx';
import apps from '../../data/apps.json';

// Map slugs to Atlas categories (clinical / learning / reference / productivity / external).
const CATEGORY_BY_SLUG: Record<string, 'clinical' | 'learning' | 'reference' | 'productivity' | 'external'> = {
  'dermatology-scribe': 'clinical',
  'skinoculars': 'clinical',
  'dermatopathology-navigator': 'learning',
  'mindmaps': 'learning',
  'rheum-derm-immune-atlas': 'reference',
  'dermoscopy-llm-dashboard': 'reference',
  'biologic-monitoring': 'reference',
  'skinscores': 'reference',
  'pdf-tools': 'productivity',
  'scheduler-pro': 'clinical',
  'dermai-reference': 'productivity',
  'dermascribe-legacy': 'clinical'
};

const CATEGORY_LABELS: Record<string, string> = {
  all: 'All',
  clinical: 'Clinical',
  learning: 'Learning',
  reference: 'Reference',
  productivity: 'Productivity'
};

// Filter to active apps that are also publicly listed.
// Set `"listed": false` on an apps.json entry to keep the data record but hide it
// from the catalog (e.g., private dashboards still hosted at a subdomain but not
// advertised on the public site).
const active = apps.filter((app) => app.status === 'active' && app.listed !== false);
const enriched = active.map((app, idx) => ({
  ...app,
  plateNumber: `III.${String(idx + 1).padStart(2, '0')}`,
  category: CATEGORY_BY_SLUG[app.slug] ?? 'clinical',
  isExternal: typeof app.href === 'string' && app.href.startsWith('http')
}));

const totalCount = enriched.length;
const counts: Record<string, number> = {
  all: totalCount,
  featured: enriched.filter((app) => app.featured).length,
  clinical: enriched.filter((app) => app.category === 'clinical').length,
  learning: enriched.filter((app) => app.category === 'learning').length,
  reference: enriched.filter((app) => app.category === 'reference').length,
  productivity: enriched.filter((app) => app.category === 'productivity').length
};
---
<MainLayout title="Applications – Ramie Fathy, MD" description="Interactive dermatology tools and prototypes developed by Dr. Ramie Fathy.">
  <Header client:load />
  <main id="main-content">
    <section class="section">
      <div class="plate-stamp"><b>Apps</b><span class="barcode"></span><span>Catalog</span></div>

      <div class="plate-head">
        <div>
          <span class="kicker">Applications</span>
          <h1 class="display1" style="margin-top:14px">Browser-first<br><em>clinical tools</em>.</h1>
        </div>
        <div class="right">
          Apps & projects · 2026.<br>
          Local-first by default.<br>
          <span style="color:var(--terracotta)">— sorted by ID —</span>
        </div>
      </div>

      <p class="lede">Applications for resident clinics, dermatology education, and research workflows.</p>

      <div class="apps-toolbar" style="margin-top:48px">
        <div class="left" id="apps-filters">
          <button class="active" data-filter="all">All <span class="c">{counts.all}</span></button>
          <button data-filter="featured">Featured <span class="c">{counts.featured}</span></button>
          <button data-filter="clinical">Clinical <span class="c">{counts.clinical}</span></button>
          <button data-filter="learning">Learning <span class="c">{counts.learning}</span></button>
          <button data-filter="reference">Reference <span class="c">{counts.reference}</span></button>
          <button data-filter="productivity">Productivity <span class="c">{counts.productivity}</span></button>
        </div>
        <div class="right" style="display:flex;align-items:center;gap:10px">
          <span>›</span>
          <input id="apps-search" type="search" placeholder="filter by name, stack, or tag…" />
        </div>
      </div>

      <div class="apps-plates" id="apps-grid">
        {enriched.map((app) => (
          <a
            class={`app-plate cat-${app.category}`}
            href={app.href}
            target={app.isExternal ? '_blank' : undefined}
            rel={app.isExternal ? 'noreferrer' : undefined}
            data-name={app.name.toLowerCase()}
            data-stack={(app.stack || []).join(' ').toLowerCase()}
            data-category={app.category}
            data-featured={app.featured ? 'true' : 'false'}
          >
            <span class="swatch"></span>
            <div class="stamp">
              <span class="pn">{app.plateNumber}</span>
              <span class={`st ${app.featured ? 'featured' : ''}`}>{app.featured ? 'Featured' : (app.isExternal ? 'External' : 'Active')}</span>
            </div>
            <h4>{app.name.replace(/^RAMIE - /, 'RAMIE — ')}</h4>
            <p>{app.description}</p>
            <div class="stack">
              {(app.stack || []).slice(0, 3).map((tag) => <span>{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <script>
    (function () {
      const filterButtons = document.querySelectorAll('#apps-filters button');
      const searchInput = document.getElementById('apps-search') as HTMLInputElement | null;
      const grid = document.getElementById('apps-grid');
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('.app-plate'));

      let activeFilter = 'all';
      let activeSearch = '';

      const applyFilters = () => {
        for (const card of cards) {
          const matchesFilter =
            activeFilter === 'all' ||
            (activeFilter === 'featured' ? card.dataset.featured === 'true' : card.dataset.category === activeFilter);
          const haystack = `${card.dataset.name || ''} ${card.dataset.stack || ''}`;
          const matchesSearch = !activeSearch || haystack.includes(activeSearch);
          card.style.display = matchesFilter && matchesSearch ? '' : 'none';
        }
      };

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          filterButtons.forEach((other) => other.classList.remove('active'));
          button.classList.add('active');
          activeFilter = (button as HTMLButtonElement).dataset.filter || 'all';
          applyFilters();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', () => {
          activeSearch = searchInput.value.trim().toLowerCase();
          applyFilters();
        });
      }
    })();
  </script>
</MainLayout>
