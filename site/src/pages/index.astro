---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.jsx';
import FieldHero from '../components/FieldHero.jsx';
import profile from '../data/profile.json';
import apps from '../data/apps.json';
import { publications } from '../data/publications.js';

const featuredApps = apps
  .filter((app) => app.status === 'active' && app.slug !== 'dermatology-scribe')
  .slice(0, 3);

const featuredPublications = [...publications]
  .filter((entry) => entry.featured)
  .sort((a, b) => b.year - a.year)
  .slice(0, 4);

const activeAppCount = apps.filter((app) => app.status === 'active' && app.listed !== false).length;

// Short, honest status words for the app cells — not colour-coded alone; the
// label carries the meaning and the coral dot is decoration.
const APP_STATUS = ['running', 'running', 'growing'];
---
<MainLayout title="Ramie Fathy, MD – Dermatology & Clinical AI" description={profile.summary}>
  <Header client:load />

  <main id="main-content">
    <FieldHero client:load profile={profile} />

    <!-- =================== Software =================== -->
    <section id="apps" class="section">
      <div class="section-head">
        <div>
          <span class="cmd-preface"><b>$</b> ls apps --featured</span>
          <h2 class="display2">Software</h2>
        </div>
        <a class="section-action" href="/apps">View all {activeAppCount} →</a>
      </div>

      <p class="lede" style="margin-bottom:32px">Browser-based clinical instruments — privacy-preserving, no account required, built around real clinic and resident-education workflows.</p>

      <div class="f-apps">
        {featuredApps.map((app, idx) => (
          <a
            class="f-app"
            href={app.href}
            target={app.href.startsWith('http') ? '_blank' : undefined}
            rel={app.href.startsWith('http') ? 'noreferrer' : undefined}
          >
            <span class="f-app__idx">{String(idx + 1).padStart(2, '0')}</span>
            <span class="f-app__status">{APP_STATUS[idx] ?? 'running'}</span>
            <h3 class="f-app__title">{app.name.replace(/^RAMIE - .*/, 'RAMIE')}</h3>
            <p class="f-app__desc">{app.description}</p>
            <span class="f-app__stack">{(app.stack || []).slice(0, 3).join(' · ').toLowerCase()}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- =================== Publications =================== -->
    <section id="publications" class="section">
      <div class="section-head">
        <div>
          <span class="cmd-preface"><b>$</b> ls publications --recent</span>
          <h2 class="display2">Selected publications</h2>
        </div>
        <a class="section-action" href="/research">Full list →</a>
      </div>

      <div class="f-pubs">
        {featuredPublications.map((entry) => (
          <a class="f-pub" href={entry.url} target="_blank" rel="noreferrer">
            <span class="f-pub__year">{entry.year}</span>
            <p class="f-pub__title">
              {entry.title}
              <span class="f-pub__authors">{entry.authors}</span>
            </p>
            <span class="f-pub__venue">{entry.venue.replace(/\.\s*\d{4}.*$/, '').toLowerCase()}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- =================== About =================== -->
    <section id="about" class="section">
      <div class="section-head">
        <div>
          <span class="cmd-preface"><b>$</b> whoami --verbose</span>
          <h2 class="display2">About</h2>
        </div>
        <a class="section-action" href="/about">Full bio →</a>
      </div>

      <div class="f-about">
        <p class="f-about__lede">{profile.about.intro}</p>
        <div class="f-facts">
          {(profile.facts || []).map((fact) => (
            <div class="f-fact">
              <span class="f-fact__key">{fact.key}</span>
              <span class="f-fact__value"><strong>{fact.lead}</strong>{fact.rest}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</MainLayout>
