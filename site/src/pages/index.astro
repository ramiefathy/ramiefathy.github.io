---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.jsx';
import Hero from '../components/Hero.jsx';
import profile from '../data/profile.json';
import apps from '../data/apps.json';
const featuredApps = apps
  .filter((app) => app.status === 'active' && app.slug !== 'dermatology-scribe')
  .slice(0, 3);
---
<MainLayout title="Ramie Fathy, MD – Dermatology & AI" description={profile.summary}>
  <Header client:load />

  <main id="main-content">
  <Hero client:visible profile={profile} />

  <section id="about" class="section">
    <div class="section__inner scroll-fade" data-scroll-fade>
      <div class="section__intro">
        <h2 class="section__title">About</h2>
        <p class="section__subtitle">{profile.about.intro}</p>
      </div>
      <div class="card-grid">
        {profile.about.highlights.map((item) => (
          <div class="card" style="min-height:180px">
            <p style="margin:0">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="apps" class="section" style="background:linear-gradient(180deg, rgba(239,246,255,0.8), rgba(255,255,255,0.92))">
    <div class="section__inner scroll-fade" data-scroll-fade>
      <div class="section__intro">
        <h2 class="section__title">Featured Applications</h2>
        <p class="section__subtitle">A few of the tools I've built. <a href="/apps">Full catalog →</a></p>
      </div>
      <div class="app-showcase">
        {featuredApps.map((app, index) => {
          const accent = app.accent ?? ['#3b82f6', '#8b5cf6'];
          const gradient = `linear-gradient(135deg, ${accent[0]}, ${accent[1] ?? accent[0]})`;
          const isExternal = app.href?.startsWith('http');
          return (
            <div class={`app-showcase-row scroll-fade ${index % 2 === 1 ? 'app-showcase-row--reverse' : ''}`} data-scroll-fade>
              <div class="app-showcase-media">
                {app.previewImage ? (
                  <img src={app.previewImage} alt={`${app.name} preview`} class="app-preview-image" loading="lazy" />
                ) : (
                  <div class="app-preview-placeholder" style={`background:${gradient}`}>
                    <span class="app-preview-icon">{app.name.charAt(0)}</span>
                  </div>
                )}
              </div>
              <div class="app-showcase-body">
                <h3 class="app-showcase-title">{app.name}</h3>
                <p class="app-showcase-description">{app.description}</p>
                <div class="app-showcase-tags">
                  {app.stack.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                <a class="button button--primary" href={app.href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noreferrer' : undefined}>
                  Open
                </a>
              </div>
            </div>
          );
        })}
      </div>
      <div style="margin-top:2.5rem;text-align:center">
        <a class="button button--secondary" href="/apps">View Full Applications Directory</a>
      </div>
    </div>
  </section>

  <section id="contact" class="section" style="background:linear-gradient(180deg, rgba(248,250,252,0.95), rgba(255,255,255,1))">
    <div class="section__inner scroll-fade" data-scroll-fade style="max-width:680px;text-align:center">
      <div class="section__intro">
        <h2 class="section__title">Get in Touch</h2>
        <p class="section__subtitle">Collaborations, speaking, and press — drop a note.</p>
      </div>
      <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:0.75rem;margin-top:1.5rem">
        <a class="button button--primary" href={profile.contact.email}>Email</a>
        <a class="button button--secondary" href={profile.contact.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a class="button button--secondary" href={profile.contact.scholar} target="_blank" rel="noreferrer">Google Scholar</a>
      </div>
    </div>
  </section>
  </main>
</MainLayout>
