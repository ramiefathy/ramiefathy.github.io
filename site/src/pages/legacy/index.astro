---
import MainLayout from '../../layouts/MainLayout.astro';
import legacy from '../../data/legacy.json';
---
<MainLayout title="Legacy Work – Ramie Fathy, MD" description="Archived research reports and prototypes maintained for reference.">
  <header class="navbar">
    <div class="navbar__inner">
      <div style="font-weight:700;font-size:1.1rem;color:var(--secondary-900)">Legacy Archive</div>
      <nav class="navbar__links">
        <a class="navbar__link" href="/">Home</a>
        <a class="navbar__link" href="/apps">Applications</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="section" style="padding-top:4rem">
      <div class="section__inner">
        {legacy.sections.map((section) => (
          <div style="margin-bottom:3rem">
            <div class="section__intro" style="margin-bottom:2rem">
              <h2 class="section__title" style="margin-bottom:0.5rem">{section.title}</h2>
            </div>
            <div class="card-grid">
              {section.items.map((item) => (
                <a class="card" href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>
                  <h3 class="card__title">{item.name}</h3>
                  <p>{item.note ?? 'Archived resource available for historical context.'}</p>
                  <div class="card__meta">
                    <span class="tag">{item.year}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</MainLayout>
