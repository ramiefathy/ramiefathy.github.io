---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.jsx';
import DermoscopyLLMEvaluationDashboard from '../../components/DermoscopyLLMEvaluationDashboard.jsx';
---

<MainLayout
  title="Dermoscopy LLM Evaluation Dashboard – Ramie Fathy, MD"
  description="Interactive dashboard exploring multimodal LLM performance on dermoscopic image classification across 17 models and 6 prompting strategies."
>
  <Header client:load />
  <main id="main-content">
    <section class="section" style="padding-bottom: 0">
      <div class="section__inner scroll-fade" data-scroll-fade>
        <div class="section__intro section__intro--split">
          <div>
            <p class="section__kicker">Research Dashboard</p>
            <h1 class="section__title">Dermoscopy LLM Evaluation</h1>
            <p class="section__subtitle">
              Interactive exploration of model performance across 17 multimodal LLMs, 6 prompting strategies, and 8 diagnoses.
            </p>
          </div>
          <div class="section__actions">
            <a class="button button--secondary" href="/research">Back to research</a>
            <a class="button button--primary" href="/apps">Browse apps</a>
          </div>
        </div>
        <p class="muted-callout">
          This dashboard summarizes aggregate results from a dermoscopy classification evaluation study. It is intended for research exploration only and is not medical
          advice.
        </p>
      </div>
    </section>

    <section class="section" style="padding-top: 2.5rem">
      <div class="section__inner">
        <DermoscopyLLMEvaluationDashboard client:load />
      </div>
    </section>
  </main>
</MainLayout>

