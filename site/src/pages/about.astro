---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.jsx';
import profile from '../data/profile.json';
import skills from '../data/skills.json';
import timeline from '../data/timeline.json';
import { getProfileCity, getTimelineRows } from '../lib/profilePresentation';

const clinicalTraining = getTimelineRows(timeline.milestones, ['education', 'training', 'fellowship']);
const leadership = getTimelineRows(timeline.milestones, ['leadership']);
const city = getProfileCity(profile.location);

const domains = [
  { key: 'clinical', label: 'Clinical', cls: 'clinical', items: skills.clinical?.skills ?? [] },
  { key: 'technical', label: 'Technical', cls: 'technical', items: skills.technical?.skills ?? [] },
  { key: 'scholarly', label: 'Scholarly', cls: 'scholarly', items: skills.research?.skills ?? [] }
];
---
<MainLayout title="About – Ramie Fathy, MD" description="Biography, training, leadership, and interests for Dr. Ramie Fathy.">
  <Header client:load />
  <main id="main-content">
    <section class="section">
      <div class="section-marker"><b>$</b><span>cat about.md</span></div>

      <div class="section-head">
        <div>
          <span class="kicker">Biography</span>
          <h1 class="display1" style="margin-top:14px">A clinician,<br>a writer, <em>a builder.</em></h1>
        </div>
        <div class="right">
          Training, service,<br>
          and the three domains<br>
          the work sits across.
        </div>
      </div>

      <div class="about-cover" style="margin-top:32px">
        <div class="portrait" role="img" aria-label="Portrait of Ramie Fathy"></div>
        <div class="text">
          <p class="lede" style="font-size:22px">{profile.about.intro}</p>
          <p class="body-copy">My work spans inflammatory dermatoses, cutaneous oncology, teledermatology, and clinical AI. I build decision-support tools, study technology in clinical settings, and write for trainees, clinicians, and patients.</p>
          <p class="body-copy">Outside the clinic I mentor medical students, work on audio storytelling projects, and explore {city}.</p>
          <div style="display:flex;gap:24px;align-items:center;margin-top:auto">
            <a class="button button--primary" href="/contact">Get in touch →</a>
            <a class="button button--secondary" href="/apps">Browse the apps →</a>
          </div>
        </div>
      </div>

      <!-- CV register -->
      <div class="cv-table">
        <div class="cv-section">
          <div class="cv-section-label">
            <span class="kicker">Section A</span>
            <h4>Clinical <em>Training</em></h4>
            <p>Training and degrees, in reverse chronological order.</p>
          </div>
          <div class="cv-rows">
            {clinicalTraining.map((row) => (
              <div class="r" data-milestone-id={row.id}>
                <span class="y">{row.y}</span>
                <span><b>{row.what}</b><span class="role">{row.role}</span></span>
                <span class="tag">{row.tag}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="cv-section">
          <div class="cv-section-label">
            <span class="kicker">Section B</span>
            <h4>Leadership <em>& Service</em></h4>
            <p>Elected and appointed roles spanning institutional and national bodies.</p>
          </div>
          <div class="cv-rows">
            {leadership.map((row) => (
              <div class="r" data-milestone-id={row.id}>
                <span class="y">{row.y}</span>
                <span><b>{row.what}</b><span class="role">{row.role}</span></span>
                <span class="tag">{row.tag}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Domain plates (replaces fake skill-bar percentages) -->
      <div class="section-head" style="margin-top:64px">
        <div>
          <span class="kicker">Domains</span>
          <h2 class="display2" style="margin-top:8px">Three <em>overlapping</em> domains.</h2>
        </div>
      </div>
      <p class="lede">The interesting projects sit in the intersections: RAMIE in clinical and technical work, the JAAD essay in scholarly and clinical work, and the dermoscopy dashboard in technical and scholarly work.</p>

      <div class="domains-plates" style="margin-top:32px">
        {domains.map((domain, idx) => (
          <div class={`domain-plate ${domain.cls}`}>
            <div class="head">
              <h4>{domain.label}</h4>
              <span class="ct">{['A', 'B', 'C'][idx]}</span>
            </div>
            <ul>
              {domain.items.map((skill) => (
                <li>
                  <span>{skill.name}<small style="display:block;color:var(--slate);font-family:var(--font-mono);font-size:11px;margin-top:1px;letter-spacing:0.04em">{skill.description}</small></span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      {/* Postscript — companion essays: sonic self-portrait at /music/, ludic at /games/ */}
      <div class="section-head" style="margin-top:64px">
        <div>
          <span class="kicker">Postscript · Companion essays</span>
          <h2 class="display2" style="margin-top:8px">Outside the clinic, a few <em>self-portraits</em> in data.</h2>
        </div>
      </div>
      <p class="lede">A close reading of my Spotify all-time top 100 — Pareto distributions, era cartography, a genre map, and a weighted carousel of every album cover. Honest data about what I actually play. Its companion, <em>Revealed Preference</em>, reads the full streaming history with timestamps — what gets played, when, and the gap between the library I curate and the music I actually reach for. A third piece, a <em>ludic self-portrait</em>, runs the same analysis on my all-time favorite games — genre concentration, a two-axis era map of when each game was made versus when I played it, and the same honest look at what I keep returning to.</p>
      <div style="display:flex;gap:24px;align-items:center;margin-top:24px;flex-wrap:wrap">
        <a class="button button--primary" href="/music/">Read the music essay →</a>
        <a class="button button--primary" href="/music/listening-history/">Read the companion →</a>
        <a class="button button--primary" href="/games/">Read the games essay →</a>
      </div>
    </section>
  </main>
</MainLayout>
