      ] },
      { "id": "no-primary", "type": "terminal", "prompt": "Use systemic/neuropathic/psychogenic pruritus pathway" },
      { "id": "morphology", "type": "decision", "prompt": "Are lesions eczematous plaques or dermatitis pattern?", "branches": [
        { "label": "Eczematous", "nextStepId": "eczema" },
        { "label": "Not eczema", "nextStepId": "wheals" }
      ] },
      { "id": "eczema", "type": "terminal", "prompt": "Atopic/contact/nummular dermatitis pathway" },
      { "id": "wheals", "type": "decision", "prompt": "Are transient wheals or angioedema present?", "branches": [
        { "label": "Yes", "nextStepId": "urticaria" },
        { "label": "No", "nextStepId": "burrows" }
      ] },
      { "id": "urticaria", "type": "terminal", "prompt": "Urticaria/angioedema pathway" },
      { "id": "burrows", "type": "decision", "prompt": "Burrows, web spaces, genital papules, or household itch?", "branches": [
        { "label": "Yes", "nextStepId": "scabies" },
        { "label": "No", "nextStepId": "papulosquamous" }
      ] },
      { "id": "scabies", "type": "terminal", "prompt": "Scabies evaluation/treatment" },
      { "id": "papulosquamous", "type": "terminal", "prompt": "Papulosquamous, bullous, drug, or biopsy pathway" }
    ]
  },
