# ===== GITHUB PAGES OPTIMIZED .GITIGNORE =====

# === Operating System Files ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# === Editor and IDE Files ===
.idea/
.vscode/
*.swp
*.swo
*~

# === R and RStudio ===
.Rhistory
.RData
.Rproj.user/
.Ruserdata
.Rapp.history
*.nb.html
*.Rmd~
*.html~

# === Node.js and npm ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.eslintcache

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# === Build Artifacts (GitHub Pages serves source files directly) ===
_site/
dist/
build/
.next/
out/

# === Logs and Temporary Files ===
*.log
*.tmp
*.bak
*.cache

# === Environment Files ===
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# === Large Data Files (customize as needed) ===
*.csv
*.tsv
*.xlsx
*.xls
*.parquet

# === PRIVATE CONTENT (Keep these patterns to protect sensitive data) ===
private/
assets/private/
server/
*_files/

# === DISABLED BUILD TOOLS (No longer needed for GitHub Pages) ===
webpack.config.js.disabled
netlify.toml.disabled

# === GitHub Pages Specific ===
# GitHub Pages automatically ignores these, but good to be explicit
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# === Application-Specific Rules ===
# Allow public app HTML files but protect sensitive components
!apps/*.html
apps/*/js/*.js
apps/*/components/*.html
apps/*/css/*.css
apps/*/config/*.json

# Keep only essential files for specific apps
!apps/dermatology-study-system/index.html
!apps/dermatology-study-system/README.md

# (Legacy analysis files removed; keep default ignore behavior)

# === Security ===
*.key
*.pem
*.p12
*.pfx
secrets/
