# === Environment Files ===
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# === Large Data Files (customize as needed) ===
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.pdf
*.docx

# Exception: Keep documentation PDFs if needed
# !docs/**/*.pdf

# === PRIVATE CONTENT (Keep these patterns to protect sensitive data) ===
private/
assets/private/
server/
*_files/

# === DISABLED BUILD TOOLS (No longer needed for GitHub Pages) ===
webpack.config.js.disabled
netlify.toml.disabled
package-lock.json

# === GitHub Pages Specific ===
# GitHub Pages automatically ignores these, but good to be explicit
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# === Application-Specific Rules ===
# Allow public app HTML files but protect sensitive components
!apps/*.html
apps/*/js/*.js
apps/*/components/*.html
apps/*/css/*.css
apps/*/config/*.json

# Keep only essential files for specific apps
!apps/dermatology-study-system/index.html
!apps/dermatology-study-system/README.md

# === Public HTML Analysis Files (Explicitly allow these) ===
!20200625_AAD-Modules-Analysis_RAF.html
!20200102_r_dermatology_analysis_RAF.html
!20191121_WoundCareWebpages2.html
!20191121_WoundCareWebpages.html
!20191028_CTCL.nb2.html

# === Security ===
*.key
*.pem
*.p12
*.pfx
secrets/
*secret*
*password*
*credentials*.json
service-account*.json

# Firebase service accounts
**/service-account*.json
functions-backend/service-account*.json

# Clinic Scheduler test credentials
apps/clinic-scheduler-pro/functions-backend/service-account-test.json

# === Audit and Analysis Files (Development artifacts) ===
audit/

# Exception: Keep security audit in root
!SECURITY-AUDIT.md

# Exception: Keep committed audit reports if needed
!docs/audit/
