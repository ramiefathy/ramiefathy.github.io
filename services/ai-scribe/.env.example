# Copy this file to .env and populate with production secrets before running the service.
# Gemini API configuration
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Required: choose a currently available, deployment-validated model; no automatic model upgrade.
# The service refuses to start when this is blank.
# Model lifecycle: https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_DEFAULT_MODEL=
# Optional overrides; blank values inherit GEMINI_DEFAULT_MODEL.
GEMINI_VISION_MODEL=
GEMINI_SUGGESTION_MODEL=
# Optional comma-separated allowlist of model IDs a client may request via `modelName`.
# GEMINI_DEFAULT_MODEL is always allowed; blank means only the default model is accepted.
# Any other client value is ignored (the server model is used) and logged by rejection class only.
GEMINI_ALLOWED_MODELS=

# Websocket authentication
SESSION_SECRET=replace-with-a-long-random-string
# Separate secret used for signing/verifying JWTs (recommended to be different from SESSION_SECRET)
JWT_SIGNING_SECRET=replace-with-another-long-random-string

# Comma-separated list of allowed Origin headers (include production + localhost dev)
ALLOWED_ORIGINS=http://localhost:4321,https://ramiefathy.github.io
